    {
      "name": "Search Requests",
      "item": [
        {
          "name": "Create Search Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contactId\": \"{{contactId}}\",\n  \"source\": \"whatsapp\",\n  \"rawText\": \"Kadıköy veya Üsküdar'da 3+1 deniz manzaralı daire arıyorum. Bütçem 2-3.5 milyon TL. Asansör ve otopark şart.\",\n  \"listingType\": \"sale\",\n  \"propertyTypes\": [\"apartment\"],\n  \"budgetMin\": 2000000,\n  \"budgetMax\": 3500000,\n  \"currency\": \"TRY\",\n  \"sqmMin\": 100,\n  \"sqmMax\": 180,\n  \"roomCountMin\": \"3+1\",\n  \"roomCountMax\": \"4+1\",\n  \"cities\": [\"İstanbul\"],\n  \"districts\": [\"Kadıköy\", \"Üsküdar\"],\n  \"mustHaveFeatures\": [\"elevator\", \"parking\"],\n  \"niceToHaveFeatures\": [\"pool\", \"gym\", \"security\"],\n  \"criteria\": {\n    \"listing_type\": \"sale\",\n    \"budget\": { \"min\": 2000000, \"max\": 3500000, \"currency\": \"TRY\" },\n    \"location\": { \"cities\": [\"İstanbul\"], \"districts\": [\"Kadıköy\", \"Üsküdar\"] },\n    \"size\": { \"sqm_min\": 100, \"sqm_max\": 180 },\n    \"rooms\": { \"min\": \"3+1\", \"max\": \"4+1\" },\n    \"must_have\": [\"elevator\", \"parking\"],\n    \"nice_to_have\": [\"pool\", \"gym\", \"security\"],\n    \"view\": \"sea\",\n    \"confidence\": 0.92\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/search-requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search-requests"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('searchRequestId', response.id);",
                  "    pm.test('Search Request ID saved', function() {",
                  "        pm.expect(pm.environment.get('searchRequestId')).to.not.be.empty;",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Search Requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/search-requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search-requests"]
            }
          },
          "response": []
        },
        {
          "name": "Get Search Request by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/search-requests/{{searchRequestId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search-requests", "{{searchRequestId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Run Matching",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/search-requests/{{searchRequestId}}/match",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search-requests", "{{searchRequestId}}", "match"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has matches array', function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('matches');",
                  "    pm.expect(response).to.have.property('totalFound');",
                  "});",
                  "",
                  "pm.test('Matches have score breakdown', function() {",
                  "    const response = pm.response.json();",
                  "    if (response.matches.length > 0) {",
                  "        const match = response.matches[0];",
                  "        pm.expect(match.scoreBreakdown).to.have.property('location_match');",
                  "        pm.expect(match.scoreBreakdown).to.have.property('price_match');",
                  "        pm.expect(match.scoreBreakdown).to.have.property('size_match');",
                  "        pm.expect(match.scoreBreakdown).to.have.property('features_match');",
                  "        pm.expect(match.scoreBreakdown).to.have.property('room_match');",
                  "        pm.expect(match.scoreBreakdown).to.have.property('total');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
