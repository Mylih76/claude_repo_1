    {
      "name": "Listings",
      "item": [
        {
          "name": "Create Listing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingType\": \"sale\",\n  \"propertyType\": \"apartment\",\n  \"title\": \"3+1 Deniz Manzaralı Daire\",\n  \"description\": \"Kadıköy Moda'da eşsiz deniz manzaralı, yeni tadilatlı daire.\",\n  \"price\": 2500000,\n  \"currency\": \"TRY\",\n  \"grossSqm\": 150,\n  \"netSqm\": 130,\n  \"roomCount\": \"3+1\",\n  \"buildingAge\": 5,\n  \"floorNumber\": 8,\n  \"totalFloors\": 12,\n  \"isFurnished\": false,\n  \"heatingType\": \"central\",\n  \"viewType\": \"sea\",\n  \"isInComplex\": true,\n  \"dues\": 1500,\n  \"city\": \"İstanbul\",\n  \"district\": \"Kadıköy\",\n  \"neighborhood\": \"Moda\",\n  \"features\": [\"elevator\", \"parking\", \"security\", \"pool\", \"gym\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/listings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "listings"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('listingId', response.id);",
                  "    pm.test('Listing ID saved to environment', function() {",
                  "        pm.expect(pm.environment.get('listingId')).to.not.be.empty;",
                  "    });",
                  "}",
                  "",
                  "pm.test('Status code is 201', function() {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Listings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/listings?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "listings"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has data and meta', function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('data');",
                  "    pm.expect(response).to.have.property('meta');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Listings with Filters",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/listings?listingType=sale&city=İstanbul&minPrice=1000000&maxPrice=5000000&minSqm=100",
              "host": ["{{baseUrl}}"],
              "path": ["api", "listings"],
              "query": [
                { "key": "listingType", "value": "sale" },
                { "key": "city", "value": "İstanbul" },
                { "key": "minPrice", "value": "1000000" },
                { "key": "maxPrice", "value": "5000000" },
                { "key": "minSqm", "value": "100" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Listing by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/listings/{{listingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "listings", "{{listingId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Update Listing",
          "request": {
            "method": "PATCH",
