              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 2750000,\n  \"description\": \"Kadıköy Moda'da eşsiz deniz manzaralı, yeni tadilatlı daire. Fiyat güncellendi.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/listings/{{listingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "listings", "{{listingId}}"]
